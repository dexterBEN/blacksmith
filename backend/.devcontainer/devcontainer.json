{
    "name": "devcontainer: blacksmith_back",
    "image": "mcr.microsoft.com/dotnet/sdk:8.0",
    "workspaceFolder": "/workspaces/backend",
    "mounts": [
        "type=bind,source=${localWorkspaceFolder},target=/workspaces/backend"
    ],
    "forwardPorts": [
        5100
    ],
    "containerEnv": {
        "ASPNETCORE_URLS": "http://0.0.0.0:5100",
        "GOOGLE_APPLICATION_CREDENTIALS": "/workspaces/backend/.devcontainer/gcp-service-account.json",
        "ConnectionStrings__BlacksmithDb": "Host=blacksmith_db_postgres;Port=5432;Database=blacksmith_db;Username=admin;Password=azerty1234"
    },
    "runArgs": [
        "--network=backend_default"
    ],
    "features": {},
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-dotnettools.csharp",
                "ms-dotnettools.csdevkit",
                "ms-azuretools.vscode-docker",
                "ms-dotnettools.vscode-dotnet-runtime"
            ]
        }
    },
    "postCreateCommand": "bash scripts/install_dependencies.sh",
    "remoteUser": "root"
}